{
  "name": "hexagon-chess-wasm",
  "version": "1.0.0",
  "description": "Hexagonal chess (Gliński & McCooey variants) with a Rust engine compiled to WebAssembly",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:wasm": "node tools/build.mjs --wasm-only",
    "serve": "node tools/serve.mjs",
    "start": "node tools/build.mjs && node tools/serve.mjs",
    "test": "node tools/test.mjs",
    "e2e": "node tools/e2e.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
